{
  "name": "bakkabook",
  "version": "1.0.0",
  "private": true,
  "description": "An independent bookshop, with a local demo and optional Supabase integration",
  "scripts": {
    "dev": "node server.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:layout": "node tests/layout-browser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "esbuild": "0.28.2",
    "prettier": "3.9.10"
  }
}
